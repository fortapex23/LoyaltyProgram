      <aspNetCore processPath="dotnet" arguments=".\LoyaltyConsole.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
