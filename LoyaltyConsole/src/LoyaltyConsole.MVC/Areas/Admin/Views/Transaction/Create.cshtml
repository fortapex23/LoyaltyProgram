@using LoyaltyConsole.MVC.Areas.Admin.ViewModels.CustomerVMs
@using LoyaltyConsole.MVC.Areas.Admin.ViewModels.TransactionVMs
@model TransactionCreateVM

@{
    List<CustomerGetVM> customers = ViewBag.Customers;
}

<!-- Content Start -->
<div class="content">
    <!-- Form Start -->
    <div class="container-fluid pt-4 px-4">
        <form method="post">
            <div class="row g-4">
                <div class="col-sm-12 col-xl-6">
                    <div class="bg-light rounded h-100 p-4">
                        <h6 class="mb-4">Create Transaction</h6>

                        <div class="form-group">
                            <label for="CustomerId">Select Customer</label>
                            <select id="CustomerId" name="CustomerId" class="form-control select2">
                                <option selected disabled value="">-- Select Customer --</option>
                                @foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.Id">@customer.FullName</option>
                                }
                            </select>
                        </div>

                        <div style="margin-top: 15px" class="form-floating mb-3">
                            <div class="input-group">
                                <input asp-for="AmountSpent" type="number" step="0.01" class="form-control" id="amountInput" placeholder="Amount">
                                <select asp-for="Currency" class="form-control"
                                        asp-items="Html.GetEnumSelectList<LoyaltyConsole.MVC.Enums.Currencies>()">
                                    <option selected disabled>select currency</option>
                                </select>
                            </div>
                            @* <label for="amountInput">Amount Spent</label> *@
                            <span asp-validation-for="AmountSpent" class="text-danger"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <select asp-for="Business" class="form-control"
                                    asp-items="Html.GetEnumSelectList<LoyaltyConsole.MVC.Enums.BusinessTypes>()">
                                <option selected disabled>Choose Business</option>
                            </select>
                            <label for="Business">Business</label>
                            <span asp-validation-for="Business" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">TransactionDate</label>
                            <input asp-for="TransactionDate" class="form-control" style="width: 40%" placeholder=Transaction Date">
                            <span asp-validation-for="TransactionDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div style="margin-top: 10px">
                <button type="submit" class="btn btn-primary">Create</button>
                <button asp-action="" class="btn btn-secondary">Cancel</button>
            </div>
        </form>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <!-- Form End -->

</div>
<!-- Content End -->

<script>
     $(document).ready(function () {
        $('.select2').select2({
            placeholder: "Search for a customer",
            allowClear: true
        });
    });

    $(document).ready(function () {
        $('.select2').select2({
            placeholder: "Search for a customer",
            allowClear: true
        });

        const rates = {
            USD: 1.7,   // 1 USD = 1.7 AZN
            EUR: 1.83,  // 1 EUR = 1.83 AZN
            AZN: 1
        };

        $('#amountInput').on('blur', function () {
            const amount = parseFloat($(this).val());
            const currency = $('#currencySelect').val();

            if (!isNaN(amount) && currency !== 'AZN') {
                const aznAmount = (amount * rates[currency]).toFixed(2);
                $(this).val(aznAmount);
                $('#currencySelect').val('AZN');
                alert(`Converted to ₼ ${aznAmount} AZN`);
            }
        });
    });
</script>